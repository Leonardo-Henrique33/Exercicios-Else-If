        <attribute name="edited" value="QWRtaW47REVTS1RPUC00UU9JOFVKOzIwMjYtMDQtMjE7IjA0OjMyOjUxICI7MzsyODY5"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="altura" type="Real" array="False" size=""/>
            <output expression="&quot;Informe sua altura em metros:&quot;" newline="True"/>
            <input variable="altura"/>
            <if expression="altura &gt; 0">
                <then>
                    <if expression="altura &gt;= 1.40">
                        <then>
                            <output expression="&quot;Sua altura &#233; &quot; &amp; altura&amp;&quot;m Pode entrar no brinquedo&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;Sua altura &#233; &quot; &amp; altura&amp;&quot;m Altura insuficiente&quot;" newline="True"/>
                        </else>
                    </if>
                </then>
                <else>
                    <output expression="&quot;A altura digitada &#233; inv&#225;lida.&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
