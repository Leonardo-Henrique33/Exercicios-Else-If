    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="altura" type="Real" array="False" size=""/>
            <output expression="&quot;Informe sua altura em metros: &quot;" newline="True"/>
            <input variable="altura"/>
            <if expression="altura &gt;= 1.40">
                <then>
                    <output expression="&quot;Pode entrar no brinquedo.&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Altura insuficiente.&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
