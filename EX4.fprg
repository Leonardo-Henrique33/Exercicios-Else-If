        <attribute name="edited" value="QWRtaW47REVTS1RPUC00UU9JOFVKOzIwMjYtMDQtMjE7IjEyOjEzOjI2ICI7MTsyODY3"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="senhaCadastrada, senhaConfirmacao" type="String" array="False" size=""/>
            <output expression="&quot;Cadastre uma senha:&quot;" newline="True"/>
            <input variable="senhaCadastrada"/>
            <output expression="&quot;Digite novamente a senha para confirma&#231;&#227;o:&quot;" newline="True"/>
            <input variable="senhaConfirmacao"/>
            <if expression="senhaCadastrada = senhaConfirmacao">
                <then>
                    <output expression="&quot;Acesso permitido.&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Senha incorreta.&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
